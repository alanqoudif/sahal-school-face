# مسار البيانات المحلي (قاعدة SQLite + الصور + النسخ الاحتياطي)
SAHAL_DATA_DIR=./data

# توقيت المدرسة (يوم الحضور)
SAHAL_TZ=Asia/Riyadh
TZ=Asia/Riyadh

# كلمة دخول الإدارة. غيّرها قبل التشغيل على سيرفر المدرسة.
SAHAL_ADMIN_PASSWORD=sahal

# مفتاح توقيع الجلسة. إذا فاضي، النظام يولّد ملفاً في data/.secret
# SAHAL_SECRET_KEY=

# احتفظ بالنسخ الاحتياطية هذا العدد من الأيام
SAHAL_BACKUP_KEEP_DAYS=30

# فترة النسخ التلقائي داخل دوكر بالثواني (86400 = يوم)
SAHAL_BACKUP_INTERVAL_SECONDS=86400

# عتبة التعرف وهامش الفرق عن ثاني أقرب وجه
SAHAL_MATCH_THRESHOLD=0.52
SAHAL_MATCH_MARGIN=0.08

# 0 لإيقاف تقدير التعبير والانتباه (وضوح الصورة يبقى)
# SAHAL_FACE_CUES=1
