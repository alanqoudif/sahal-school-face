# مسار البيانات المحلي (قاعدة SQLite + الصور + النسخ الاحتياطي)
SAHAL_DATA_DIR=./data

# توقيت المدرسة (يوم الحضور). لازم يطابق توقيت الجهاز، مثل Asia/Dubai أو Asia/Riyadh
SAHAL_TZ=Asia/Dubai
TZ=Asia/Dubai

# كلمة دخول الإدارة. غيّرها قبل التشغيل على سيرفر المدرسة.
SAHAL_ADMIN_PASSWORD=sahal

# مفتاح توقيع الجلسة. إذا فاضي، النظام يولّد ملفاً في data/.secret
# SAHAL_SECRET_KEY=

# احتفظ بالنسخ الاحتياطية هذا العدد من الأيام
SAHAL_BACKUP_KEEP_DAYS=30

# فترة النسخ التلقائي داخل دوكر بالثواني (86400 = يوم)
SAHAL_BACKUP_INTERVAL_SECONDS=86400

# عتبة التعرف وهامش الفرق عن ثاني أقرب وجه
SAHAL_MATCH_THRESHOLD=0.52
SAHAL_MATCH_MARGIN=0.08

# حجم مدخل كاشف الوجوه. أكبر = يلتقط وجوهاً أصغر وأبعد (أبطأ قليلاً)
# SAHAL_DET_SIZE=1024

# 0 لإيقاف تقدير التعبير والانتباه (وضوح الصورة يبقى)
# SAHAL_FACE_CUES=1

# ---- كاميرا EZVIZ (RTSP) — تُقرأ من السيرفر فقط، لا تصل للمتصفح أبداً ----
# انسخ هذا الملف إلى .env واملأ القيم. لا ترفع .env إلى Git.
# اتركه فاضي CAMERA_HOST لتعطيل الكاميرا.
CAMERA_HOST=192.168.0.100
CAMERA_PORT=554
CAMERA_USERNAME=admin
# رمز التحقق (Verification Code) المطبوع على الكاميرا
CAMERA_PASSWORD=
CAMERA_STREAM_PATH=/ch1/main
# CAMERA_ID=ezviz_ty1
# CAMERA_NAME=EZVIZ TY1
# أقصى عدد إطارات تُحفظ في الذاكرة بالثانية
# CAMERA_MAX_FPS=10
# الفاصل بين كل محاولة تعرّف في الوضع التلقائي (بالمللي ثانية)
FACE_RECOGNITION_INTERVAL_MS=1000
